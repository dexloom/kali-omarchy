#!/usr/bin/env bash
# Interactive airodump-ng prompt used by the Kali menu.
# Lists wireless interfaces, then dumps on the chosen one.
set -euo pipefail

ifaces=()
while IFS= read -r line; do ifaces+=("$line"); done < <(iw dev 2>/dev/null | awk '/Interface/ {print $2}')
(( ${#ifaces[@]} == 0 )) && { echo "No wireless interfaces found."; exit 1; }

echo "Wireless interfaces:"
for i in "${!ifaces[@]}"; do
  mode=$(iw dev "${ifaces[$i]}" info 2>/dev/null | awk '/type/ {print $2; exit}')
  printf "  %d) %s (%s)\n" "$((i+1))" "${ifaces[$i]}" "${mode:-unknown}"
done

read -rp "Interface [1]: " pick
iface="${ifaces[$(( ${pick:-1} - 1 ))]}"
[[ -z $iface ]] && { echo "Bad selection."; exit 1; }

echo
echo "> sudo airodump-ng $iface"
echo "(Ctrl-C to stop. If this errors, put the card in monitor mode first:"
echo "   sudo airmon-ng start $iface )"
echo
sudo airodump-ng "$iface"
